project Rrdespike is

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Exec_Dir use "bin";
   for Main use ("rrdespike.adb");

   package Compiler is
      for Switches ("Ada") use ("-O3", "-gnat2012", "-gnatwa");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ("-lrrd");
   end Linker;

end Rrdespike;
